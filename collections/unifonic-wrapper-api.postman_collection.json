        {
          "id": "7475a408-f40e-4747-9274-9acd3d517f91",
          "name": "Send message",
          "request": {
            "name": "Send message",
            "description": {
              "content": "Unifonic Send Wrapper API allows you to send  text messages to  multiple users at the same time",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "wrapper",
                "sendSMS.php"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "appsid",
                  "value": "<string>",
                  "description": "(Required) A character string that uniquely identifies your app"
                },
                {
                  "disabled": false,
                  "key": "msg",
                  "value": "<string>",
                  "description": "(Required) Message body supports both English and unicodes characters, concatenated messages is supported"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<long>",
                  "description": "(Required) Destination mobile number, mobile numbers must be in international format without 00 or + Example: (966000000000)"
                },
                {
                  "disabled": false,
                  "key": "sender",
                  "value": "<string>",
                  "description": "(Required) The SenderID to send from, App default SenderID is used unless else stated"
                },
                {
                  "disabled": false,
                  "key": "baseEncode",
                  "value": "false",
                  "description": "Binary-to-text encoding schemes that represent binary data in an ASCII string format"
                },
                {
                  "disabled": false,
                  "key": "encoding",
                  "value": "UCS2",
                  "description": "Converts information from a source into symbols for communication or storage, GSM7 for English and UCS2 for Arabic"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null
          },
