{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unifonic Authenticate Call Management and Status Verifications API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-authenticate-app-id",
      "value": "{{x-authenticate-app-id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Verifications",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check Verification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://authenticate.cloud.api.unifonic.com/services/api/v2/verifications/check",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "to",
                  "value": ""
                },
                {
                  "name": "channel",
                  "value": ""
                },
                {
                  "name": "code",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This API is used for verification of the OTP. In case any error, error_code will be passed alongwith  the response_status in response.\n- 101 for Correct\n- 107 for Incorrect\n- 108 for Attempts Exceeded\n- 109 for Code Expired\n- 110 for Already Verified"
        },
        {
          "info": {
            "name": "Create Verification",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://authenticate.cloud.api.unifonic.com/services/api/v2/verifications/start",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "to",
                  "value": ""
                },
                {
                  "name": "channel",
                  "value": ""
                },
                {
                  "name": "locale",
                  "value": ""
                },
                {
                  "name": "length",
                  "value": ""
                }
              ]
            }
          },
          "docs": "This endpoint sends a verification code through any of channels mainly `Sms`, `Voice` & `Whatsapp`. By default it sends messages to all configured channels in the Authenticate app."
        }
      ]
    }
  ],
  "bundled": true
}